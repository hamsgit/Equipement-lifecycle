generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id        String @id @default(uuid())
  assetCode String @unique
  assetType String
  status    String @default("ACTIVE")

  assignments     AssetAssignment[]
  lifecycleEvents LifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetType])
  @@map("assets")
}

model Component {
  id            String  @id @default(uuid())
  serialNumber  String
  partNumber    String?
  componentType String
  status        String  @default("UNKNOWN")

  assignments     AssetAssignment[]
  lifecycleEvents LifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serialNumber])
  @@index([partNumber])
  @@map("components")
}

model AssetAssignment {
  id          String @id @default(uuid())
  assetId     String
  componentId String

  installedAt DateTime?
  removedAt   DateTime?

  asset     Asset     @relation(fields: [assetId], references: [id])
  component Component @relation(fields: [componentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([componentId])
  @@index([componentId, installedAt])
  @@map("asset_assignments")
}

model Document {
  id               String @id @default(uuid())
  originalFilename String
  mimeType         String
  fileSize         Int
  storagePath      String
  sha256Hash       String @unique

  documentType     String?
  processingStatus String  @default("PENDING")

  extractedFields ExtractedField[]
  eventEvidence   EventEvidence[]

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentType])
  @@index([processingStatus])
  @@map("documents")
}

model ExtractedField {
  id         String @id @default(uuid())
  documentId String

  document Document @relation(fields: [documentId], references: [id])

  fieldName       String
  rawValue        String
  normalizedValue String?

  pageNumber  Int?
  sourceText  String?
  boundingBox Json?

  extractionMethod String?
  confidence       Float?

  // Reviewer verification status
  reviewStatus String @default("UNREVIEWED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([fieldName])
  @@map("extracted_fields")
}

model LifecycleEvent {
  id        String @id @default(uuid())
  eventType String

  assetId     String?
  componentId String?

  asset         Asset?          @relation(fields: [assetId], references: [id])
  component     Component?      @relation(fields: [componentId], references: [id])
  eventEvidence EventEvidence[]

  eventDate   DateTime?
  description String?

  // Original measurement fields retained
  usageValue Decimal? @db.Decimal(14, 3)
  usageUnit  String?

  // Separate cumulative measurements
  operatingHours Decimal? @db.Decimal(14, 3)
  usageCount     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([componentId])
  @@index([eventType])
  @@index([eventDate])
  @@map("lifecycle_events")
}

model EventEvidence {
  id         String @id @default(uuid())
  eventId    String
  documentId String

  event    LifecycleEvent @relation(fields: [eventId], references: [id])
  document Document       @relation(fields: [documentId], references: [id])

  pageNumber Int?
  sourceText String?

  evidenceType String   @default("SUPPORTING")
  createdAt    DateTime @default(now())

  @@unique([eventId, documentId, pageNumber])
  @@index([eventId])
  @@index([documentId])
  @@map("event_evidence")
}

model ValidationFinding {
  id          String  @id @default(uuid())
  findingKey  String? @unique
  ruleCode    String
  title       String
  description String
  severity    String

  recommendedAction String?

  reviews FindingReview[]

  status String @default("OPEN")

  affectedRecords Json?
  evidenceDetails Json?

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleCode])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@map("validation_findings")
}

model FindingReview {
  id        String @id @default(uuid())
  findingId String

  finding ValidationFinding @relation(fields: [findingId], references: [id])

  reviewerName   String
  previousStatus String
  newStatus      String
  comment        String?

  reviewedAt DateTime @default(now())

  @@index([findingId])
  @@index([reviewedAt])
  @@map("finding_reviews")
}

model AuditLog {
  id         String @id @default(uuid())
  actorName  String
  action     String
  entityType String
  entityId   String

  previousData Json?
  newData      Json?
  reason       String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorName])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
